{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "generate:admin-api": "python3 admin-api/generate_admin_api.py",
    "deploy:admin-api": "bash admin-api/deploy.sh",
    "dev": "cross-env NODE_ENV=development tsx server/src/index.ts",
    "dev:landing": "cd fe/landing && npm run dev",
    "dev:dashboard": "pnpm --dir fe/dashboard dev",
    "dev:pos": "cd fe/pos-system && npm run dev",
    "dev:all": "concurrently -n \"server,landing,dashboard\" -c \"blue,green,yellow\" \"npm run dev\" \"npm run dev:landing\" \"npm run dev:dashboard\"",
    "dev:all:pos": "concurrently -n \"server,landing,dashboard,pos\" -c \"blue,green,yellow,magenta\" \"npm run dev\" \"npm run dev:landing\" \"npm run dev:dashboard\" \"npm run dev:pos\"",
    "dev:all:full": "concurrently -n \"server,landing,dashboard,pos,pos-landing\" -c \"blue,green,yellow,magenta,cyan\" \"npm run dev\" \"npm run dev:landing\" \"npm run dev:dashboard\" \"npm run dev:pos\" \"npm run dev:pos-landing\"",
    "build": "npm run build:store && npm run build:landing && npm run build:server",
    "build:store": "vite build",
    "build:landing": "cd fe/landing && npm run build",
    "build:server": "esbuild server/src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:lambda": "esbuild server/lambda.cts --platform=node --bundle --format=cjs --outfile=dist/lambda.js --external:@aws-sdk/* --external:pg-native --external:@babel/* --external:lightningcss --external:vite",
    "generate:swagger": "node scripts/generate-swagger-spec.cjs",
    "generate:swagger:dist": "node scripts/generate-swagger-spec.cjs --dist",
    "package:lambda": "npm run generate:swagger:dist && npm run build:lambda && powershell.exe -Command \"Compress-Archive -Path dist/lambda.js,dist/swagger-spec.json -DestinationPath lambda-package.zip -Force\"",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:run-migration": "tsx scripts/run-migration.ts",
    "db:seed": "tsx server/src/scripts/run-rbac-seed.ts",
    "db:seed:templates": "tsx server/src/scripts/run-template-seed.ts",
    "db:seed:org-modules": "tsx server/src/scripts/run-org-modules-backfill.ts",
    "setup:template": "npm run build:store && node setup-template-bucket.js",
    "dev:pos-landing": "cd fe/pos-landing && npm run dev",
    "build:pos-landing": "cd fe/pos-landing && npm install && npm run build",
    "dev:template:tsuru-demo": "cd templates/tsuru-demo && npm run dev",
    "build:template:tsuru-demo": "cd templates/tsuru-demo && npm install && npm run build",
    "dev:template:tech-gadgets": "cd templates/tech-gadgets && npm run dev",
    "build:template:tech-gadgets": "cd templates/tech-gadgets && npm install && npm run build",
    "dev:template:vintage-fashion": "cd templates/vintage-fashion && npm run dev",
    "build:template:vintage-fashion": "cd templates/vintage-fashion && npm install && npm run build",
    "dev:template:artisan-crafts": "cd templates/artisan-crafts && npm run dev",
    "build:template:artisan-crafts": "cd templates/artisan-crafts && npm install && npm run build",
    "dev:template:gourmet-foods": "cd templates/gourmet-foods && npm run dev",
    "build:template:gourmet-foods": "cd templates/gourmet-foods && npm install && npm run build",
    "dev:template:fitness-hub": "cd templates/fitness-hub && npm run dev",
    "build:template:fitness-hub": "cd templates/fitness-hub && npm install && npm run build",
    "dev:template:pet-care": "cd templates/pet-care && npm run dev",
    "build:template:pet-care": "cd templates/pet-care && npm install && npm run build",
    "dev:template:beauty-essentials": "cd templates/beauty-essentials && npm run dev",
    "build:template:beauty-essentials": "cd templates/beauty-essentials && npm install && npm run build",
    "dev:template:pollo-porteno": "cd templates/pollo-porteno && npm run dev",
    "build:template:pollo-porteno": "cd templates/pollo-porteno && npm install && npm run build",
    "build:templates": "npm run build:template:tsuru-demo && npm run build:template:tech-gadgets && npm run build:template:vintage-fashion && npm run build:template:artisan-crafts && npm run build:template:gourmet-foods && npm run build:template:fitness-hub && npm run build:template:pet-care && npm run build:template:beauty-essentials && npm run build:template:pollo-porteno",
    "build:dashboard": "pnpm --dir fe/dashboard build",
    "deploy:all-frontend": "npm run build:templates && npm run build:dashboard && node setup-template-bucket.js"
  },
