# Local Tsuru platform-admin dashboard environment variables

# Base domain for display purposes (e.g., "tu-tienda.DOMAIN")
VITE_BASE_DOMAIN=tsuru.jcampos.dev

# Full URL of the store app (including protocol)
# For localhost development:
VITE_APP_URL=http://localhost:9000

# For production:
# VITE_APP_URL=https://tsuru.jcampos.dev

# Local platform-admin console (use the existing POS Cognito pool).
VITE_API_URL=http://localhost:5000
VITE_AWS_REGION=us-east-1
VITE_AWS_COGNITO_USER_POOL_ID=
VITE_AWS_COGNITO_CLIENT_ID=
# Optional until the support namespace is deployed. Persisted ticket/incident
# lists still work without push; set this to https://events.tsuru.jcampos.dev.
VITE_APPSYNC_EVENTS_URL=
