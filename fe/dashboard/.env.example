# Local Tsuru platform-admin dashboard environment variables

# The dashboard is local-only, but it talks to the manually deployed admin API.
VITE_ADMIN_API_URL=https://admin-api.tsuru.jcampos.dev
VITE_AWS_REGION=us-east-1
VITE_ADMIN_COGNITO_USER_POOL_ID=
VITE_ADMIN_COGNITO_CLIENT_ID=
# Optional until the support namespace is deployed. Persisted ticket/incident
# lists still work without push; set this to https://events.tsuru.jcampos.dev.
VITE_APPSYNC_EVENTS_URL=
